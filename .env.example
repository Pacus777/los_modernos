APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ------------------------------------------------------------
# Telegram Bot - Notificaciones WAYNA
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# ------------------------------------------------------------
# Google Translate API - Configuración para traducción automática
# ------------------------------------------------------------
GOOGLE_TRANSLATE_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TRANSLATE_LOCATION=global
GOOGLE_TRANSLATE_SOURCE_LANGUAGE=es


# LibreTranslate configracion
LIBRETRANSLATE_ENABLED=true
LIBRETRANSLATE_URL=http://127.0.0.1:5000/translate
LIBRETRANSLATE_SOURCE_LANGUAGE=es
LIBRETRANSLATE_API_KEY=

# Tipo de cambio configuración
TIPO_CAMBIO_ENABLED=true
TIPO_CAMBIO_PROVIDER=dolarapi
TIPO_CAMBIO_CACHE_MINUTES=60
TIPO_CAMBIO_FALLBACK_USD_TO_BOB=10.25
TIPO_CAMBIO_API_URL=https://bo.dolarapi.com/v1/dolares

DONACION_PLAZO_PAGO_MINUTOS=5

# Broadcast configuration for Reverb
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=local-wayna
REVERB_APP_KEY=local-wayna-key
REVERB_APP_SECRET=local-wayna-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"


LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# PostgreSQL (proyecto WAYNA en equipo / Laragon). Ajusta usuario, puerto (5432) y base creada.
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=los_modernos
# DB_USERNAME=postgres
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# Seeders de desarrollo (T-14): usuarios admin, cajero y sin rol de prueba.
# Copia estas claves a tu .env local. No uses contraseñas reales de producción.
# -----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@wayna.test
SEED_ADMIN_NAME="Administrador WAYNA"
SEED_ADMIN_PASSWORD=password

SEED_CAJERO_EMAIL=cajero@wayna.test
SEED_CAJERO_NAME="Cajero WAYNA"
SEED_CAJERO_PASSWORD=password

SEED_SIN_ROL_EMAIL=sinrol@wayna.test
SEED_SIN_ROL_NAME="Usuario Sin Rol"
SEED_SIN_ROL_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# S3-01 — candado anti pago duplicado
# Producción: redis + extensión phpredis en PHP (Laragon: PHP > Extensions > php_redis)
# Local sin phpredis: WAYNA_PAYMENT_LOCK_STORE=database  (usa tabla cache)
WAYNA_PAYMENT_LOCK_STORE=redis
WAYNA_PAYMENT_LOCK_TTL_SECONDS=900

# S3-02 — firma HMAC del body (header X-Webhook-Signature). Vacío = sin validar (solo local).
WAYNA_WEBHOOK_LIBELULA_SECRET=

# S3-03 — rate limiting (peticiones por IP y ventana en minutos)
WAYNA_RATE_LIMIT_LOGIN_MAX=10
WAYNA_RATE_LIMIT_LOGIN_DECAY=1
WAYNA_RATE_LIMIT_LOGIN_FAILED_MAX=5
WAYNA_RATE_LIMIT_DONACIONES_MAX=20
WAYNA_RATE_LIMIT_DONACIONES_DECAY=1
WAYNA_RATE_LIMIT_WEBHOOKS_MAX=120
WAYNA_RATE_LIMIT_WEBHOOKS_DECAY=1

# S3-04 — Google Authenticator (solo admin)
WAYNA_2FA_ISSUER="WAYNA Admin"
WAYNA_2FA_WINDOW=1

# S3-05 — sesión admin (inactividad)
WAYNA_ADMIN_SESSION_MINUTES=30
WAYNA_ADMIN_SESSION_WARN_MINUTES=5

# S3-07 — CSP y cabeceras de seguridad
WAYNA_CSP_ENABLED=true
WAYNA_CSP_REPORT_ONLY=false
WAYNA_VITE_DEV_ORIGIN=http://127.0.0.1:5173

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Tipo de cambio referencial turista (T-A24): USD por 1 Bs. Ej. 0.145 → Bs 50 ≈ USD 7.25
WAYNA_USD_POR_BS=0.145

# Plazo visual para completar pago pendiente (T-A26), en minutos
WAYNA_PAGO_PENDIENTE_MINUTOS=15
